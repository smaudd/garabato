<div id="<%= dom_id comment %>">
  <div>
    <strong><%= comment.user&.email_address || 'Usuario desconocido' %></strong>
    <small>
      created: <%= comment.created_at.strftime('%Y-%m-%d %H:%M') %>
      <% if comment.updated_at && comment.updated_at != comment.created_at %>
        | edited
      <% end %>
    </small>
  </div>
  <div>
    <%= comment.body %>
  </div>
  <div>
    <%= render partial: 'shared/likes', locals: { likeable: comment } %>
  </div>
</div>
