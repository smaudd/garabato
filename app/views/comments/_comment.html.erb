<div id="<%= dom_id comment %>" class="comment">
  <div class="comment-meta">
    <span class="comment-author"><%= comment.user&.email_address || "Anonymous" %></span>
    <span class="comment-date"><%= comment.created_at.strftime("%b %d, %Y") %></span>
    <% if comment.updated_at && comment.updated_at != comment.created_at %>
      <span class="comment-edited">(edited)</span>
    <% end %>
  </div>
  <div class="comment-body"><%= comment.body %></div>
  <div class="comment-actions">
    <%= render partial: 'shared/likes', locals: { likeable: comment } %>
    <% if authenticated? %>
      <% p = local_assigns[:post] || comment.post %>
      <%= link_to "Edit", post_path(p, edit_comment_id: comment.id), class: "btn btn-ghost btn-sm" %>
      <%= button_to "Delete", post_comment_path(p, comment), method: :delete,
          data: { turbo_confirm: "Delete comment?" }, class: "btn btn-ghost btn-sm" %>
    <% end %>
  </div>
</div>
