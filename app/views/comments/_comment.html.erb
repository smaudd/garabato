<div id="<%= dom_id comment %>">
  <div>
    <strong><%= comment.user&.email_address %></strong>
    <small>
      created: <%= comment.created_at.strftime('%Y-%m-%d %H:%M') %>
      <% if comment.updated_at && comment.updated_at != comment.created_at %>
        | edited
      <% end %>
    </small>
  </div>
  <div>
    <%= comment.body %>
  </div>
  <div>
  </div>
  <div class="flex gap-2">
    <%= render partial: 'shared/likes', locals: { likeable: comment } %>
    <% p = local_assigns[:post] || comment.post %>
    <%= link_to "Edit", post_path(p, edit_comment_id: comment.id), class: "btn" %>
    <%= button_to "Delete", post_comment_path(p, comment), method: :delete, data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>
