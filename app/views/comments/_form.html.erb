<%= form_with(model: [post, comment]) do |form| %>
  <%= render "shared/error_messages", object: comment %>

  <div class="field">
    <%= form.label :body, "Comment" %>
    <%= form.text_area :body, class: "input", rows: 3, placeholder: "Write a comment…" %>
  </div>

  <div class="form-actions">
    <%= form.submit comment.persisted? ? "Update" : "Post comment", class: "btn btn-primary btn-sm" %>
    <% if comment.persisted? %>
      <%= link_to "Cancel", post_path(post), class: "btn btn-ghost btn-sm" %>
    <% end %>
  </div>
<% end %>
