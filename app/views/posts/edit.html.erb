<% content_for :title, "Edit post" %>

<div class="flex items-center justify-between mb-4">
  <h1 style="margin:0">Edit post</h1>
  <%= link_to "← Back", post_path(@post), class: "btn btn-secondary btn-sm" %>
</div>

<div class="card form-card" style="max-width:40rem">
  <%= render "form", post: @post %>
</div>

