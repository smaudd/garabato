<div id="<%= dom_id post %>" class="post">
  <div class="post-header">
    <h2 class="post-title">
      <%= link_to post.title, post_path(post) %>
    </h2>
    <% if authenticated? %>
      <div class="flex gap-2">
        <%= link_to "Edit", edit_post_path(post), class: "btn btn-ghost btn-sm" %>
        <%= button_to "Delete", post_path(post), method: :delete,
            data: { turbo_confirm: "Delete this post?" },
            class: "btn btn-ghost btn-sm" %>
      </div>
    <% end %>
  </div>
  <div class="post-actions">
    <%= render partial: 'shared/likes', locals: { likeable: post } %>
    <%= link_to "View", post_path(post), class: "btn btn-secondary btn-sm" %>
  </div>
</div>
