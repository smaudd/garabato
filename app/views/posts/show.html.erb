

<% content_for :title, @post.title %>

<div class="flex items-center gap-3 mb-4" style="font-size:0.875rem">
  <%= link_to "← Posts", posts_path %>
</div>

<%= render @post %>

<section style="margin-top:2.5rem">
  <h2 style="font-size:1.125rem;margin-bottom:1rem">Comments</h2>
  <div id="comments">
    <% @post.comments.select(&:persisted?).each do |comment| %>
      <% if params[:edit_comment_id].to_i == comment.id %>
        <%= render "comments/form", comment: comment, post: @post %>
      <% else %>
        <%= render comment, post: @post %>
      <% end %>
    <% end %>
  </div>

  <div style="margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid #e5e7eb">
    <h3 style="font-size:1rem;margin-bottom:0.75rem">Add a comment</h3>
    <%= render "comments/form", comment: (@new_comment || @post.comments.build), post: @post %>
  </div>
</section>
