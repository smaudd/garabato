<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Admin — Garabato" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div class="admin-wrap" data-controller="admin-sidebar">

      <div class="admin-overlay" data-action="click->admin-sidebar#close"></div>

      <%# ---- Sidebar ---- %>
      <aside class="admin-sidebar">
        <%= link_to admin_root_path, class: "admin-brand" do %>
          <div class="admin-brand-mark">G</div>
          <div class="admin-brand-text">
            <div class="admin-brand-name">Garabato</div>
            <div class="admin-brand-sub"><%= t("admin.layout.brand_sub") %></div>
          </div>
        <% end %>

        <nav class="admin-nav">
          <div class="admin-nav-section"><%= t("admin.layout.nav.general") %></div>
          <%= link_to admin_root_path,
              class: "admin-nav-item #{current_page?(admin_root_path) ? 'active' : ''}" do %>
            <i class="nav-icon">⊞</i> <%= t("admin.layout.nav.dashboard") %>
          <% end %>

          <div class="admin-nav-section"><%= t("admin.layout.nav.content") %></div>
          <%= link_to admin_posts_path,
              class: "admin-nav-item #{request.path.start_with?('/admin/posts') ? 'active' : ''}" do %>
            <i class="nav-icon">◈</i> <%= t("admin.layout.nav.posts") %>
          <% end %>

          <div class="admin-nav-section"><%= t("admin.layout.nav.directory") %></div>
          <%= link_to admin_companies_path,
              class: "admin-nav-item #{request.path.start_with?('/admin/companies') ? 'active' : ''}" do %>
            <i class="nav-icon">◻</i> <%= t("admin.layout.nav.companies") %>
          <% end %>

          <div class="admin-nav-section"><%= t("admin.layout.nav.taxonomy") %></div>
          <%= link_to admin_categories_path,
              class: "admin-nav-item #{request.path.start_with?('/admin/categories') ? 'active' : ''}" do %>
            <i class="nav-icon">◇</i> <%= t("admin.layout.nav.categories") %>
          <% end %>
          <%= link_to admin_tags_path,
              class: "admin-nav-item #{request.path.start_with?('/admin/tags') ? 'active' : ''}" do %>
            <i class="nav-icon">⬡</i> <%= t("admin.layout.nav.tags") %>
          <% end %>

          <div class="admin-nav-section"><%= t("admin.layout.nav.site") %></div>
          <%= link_to root_path, class: "admin-nav-item" do %>
            <i class="nav-icon">↗</i> <%= t("admin.layout.nav.view_site") %>
          <% end %>
        </nav>

        <div class="admin-sidebar-footer">
          <% if Current.user %>
            <div class="admin-user-email"><%= Current.user.email_address %></div>
          <% end %>
          <%= button_to t("admin.layout.footer.logout"), session_path, method: :delete %>
        </div>
      </aside>

      <%# ---- Main ---- %>
      <main class="admin-main">
        <header class="admin-topbar">
          <div class="flex items-center gap-3">
            <button class="admin-menu-btn" data-action="click->admin-sidebar#toggle" aria-label="<%= t('admin.layout.menu_aria') %>">
              <span>☰</span>
            </button>
            <h1 class="admin-page-title">
              <%= content_for?(:page_title) ? yield(:page_title) : t("admin.layout.page_title_default") %>
            </h1>
          </div>
          <div class="flex items-center gap-3">
            <%= yield :header_actions %>
          </div>
        </header>

        <% if flash.any? %>
          <div class="admin-flash">
            <% flash.each do |type, message| %>
              <div class="<%= type == 'alert' ? 'alert' : 'notice' %>"><%= message %></div>
            <% end %>
          </div>
        <% end %>

        <div class="admin-content">
          <%= yield %>
        </div>
      </main>

    </div>
  </body>
</html>
