<% content_for :page_title, t('.page_title') %>
<% content_for :header_actions do %>
  <%= link_to t('.new'), new_admin_post_path, class: "btn btn-primary" %>
<% end %>

<div class="card">
  <% if @posts.any? %>
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t('.col_title') %></th>
          <th><%= t('.col_company') %></th>
          <th><%= t('.col_category') %></th>
          <th><%= t('.col_starts_at') %></th>
          <th><%= t('.col_ends_at') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @posts.each do |post| %>
          <tr>
            <td><%= link_to post.title, admin_post_path(post) %></td>
            <td class="text-muted"><%= post.company&.name || "—" %></td>
            <td><%= post.category&.name || "—" %></td>
            <td class="text-muted text-sm"><%= post.starts_at&.strftime("%d/%m/%Y") || "—" %></td>
            <td class="text-muted text-sm"><%= post.ends_at&.strftime("%d/%m/%Y") || "—" %></td>
            <td>
              <div class="td-actions">
                <%= link_to t('admin.shared.edit'), edit_admin_post_path(post) %>
                <%= button_to t('admin.shared.delete'), admin_post_path(post), method: :delete, data: { turbo_confirm: t('.confirm_delete') } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="table-empty"><%= t('.empty') %> <%= link_to t('.empty_link'), new_admin_post_path %>.</div>
  <% end %>
</div>
