<h1>Posts</h1>

<%= link_to "New post", new_admin_post_path %>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Company</th>
      <th>Category</th>
      <th>Starts at</th>
      <th>Ends at</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @posts.each do |post| %>
      <tr>
        <td><%= post.title %></td>
        <td><%= post.company&.name %></td>
        <td><%= post.category&.name %></td>
        <td><%= post.starts_at&.strftime("%d/%m/%Y") %></td>
        <td><%= post.ends_at&.strftime("%d/%m/%Y") %></td>
        <td>
          <%= link_to "View", admin_post_path(post) %> |
          <%= link_to "Edit", edit_admin_post_path(post) %> |
          <%= button_to "Delete", admin_post_path(post), method: :delete, data: { turbo_confirm: "Are you sure?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
