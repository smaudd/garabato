<%= form_with model: [:admin, post],
    data: {
      controller: "post-locations",
      post_locations_locations_url_value: locations_for_select_admin_company_path("__id__")
    } do |form| %>

  <% if post.errors.any? %>
    <div class="form-errors">
      <strong><%= pluralize(post.errors.count, "error") %> impidieron guardar:</strong>
      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :title, "Título" %>
    <%= form.text_field :title, placeholder: "Ej. 30% de descuento en toda la tienda" %>
  </div>

  <div class="form-group">
    <%= form.label :body, "Descripción" %>
    <%= form.text_area :body, placeholder: "Detalla la promoción..." %>
  </div>

  <div class="form-group">
    <%= form.label :company_id, "Empresa" %>
    <%= form.collection_select :company_id, Company.order(:name), :id, :name,
        { prompt: "Selecciona una empresa" },
        { data: { post_locations_target: "companySelect",
                  action: "change->post-locations#companyChanged" } } %>
  </div>

  <div class="form-group">
    <%= form.label :category_id, "Categoría" %>
    <%= form.collection_select :category_id, Category.order(:name), :id, :name,
        { prompt: "Sin categoría (opcional)" }, {} %>
  </div>

  <div class="form-group">
    <label>Locales</label>
    <div data-post-locations-target="locationsContainer" class="checkbox-group">
      <% if post.company_id.present? %>
        <% Location.where(company_id: post.company_id).order(:name).each do |l| %>
          <label>
            <input type="checkbox" name="post[location_ids][]" value="<%= l.id %>"
              <%= post.location_ids.include?(l.id) ? "checked" : "" %>>
            <%= l.name %>
          </label>
        <% end %>
      <% else %>
        <em class="text-muted text-sm">Selecciona una empresa primero</em>
      <% end %>
    </div>
    <button type="button"
      data-post-locations-target="selectAllBtn"
      data-action="click->post-locations#toggleAll"
      <%= post.company_id.blank? ? 'hidden' : '' %>>
      Seleccionar todos
    </button>
  </div>

  <div class="form-group">
    <label>Tags</label>
    <div class="checkbox-group">
      <% selected_tag_ids = post.tag_ids %>
      <% Tag.order(:name).each do |tag| %>
        <label>
          <input type="checkbox" name="post[tag_ids][]" value="<%= tag.id %>"
            <%= selected_tag_ids.include?(tag.id) ? "checked" : "" %>>
          <%= tag.name %>
        </label>
      <% end %>
    </div>
  </div>

  <div class="form-group">
    <%= form.label :starts_at, "Fecha de inicio" %>
    <%= form.datetime_local_field :starts_at %>
  </div>

  <div class="form-group">
    <%= form.label :ends_at, "Fecha de fin" %>
    <%= form.datetime_local_field :ends_at %>
  </div>

  <div class="form-actions">
    <%= form.submit %>
    <%= link_to "Cancelar", admin_posts_path, class: "btn btn-secondary" %>
  </div>

<% end %>
