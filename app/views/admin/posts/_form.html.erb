<%= form_with model: [:admin, post],
    data: {
      controller: "post-locations",
      post_locations_locations_url_value: locations_for_select_admin_company_path("__id__")
    } do |form| %>

  <% if post.errors.any? %>
    <div class="form-errors">
      <strong><%= t('admin.shared.errors', count: post.errors.count) %></strong>
      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :title %>
    <%= form.text_field :title, placeholder: t('.title_placeholder') %>
  </div>

  <div class="form-group">
    <%= form.label :body %>
    <%= form.text_area :body, placeholder: t('.body_placeholder') %>
  </div>

  <div class="form-group">
    <%= form.label :company_id %>
    <%= form.collection_select :company_id, Company.order(:name), :id, :name,
        { prompt: t('.company_prompt') },
        { data: { post_locations_target: "companySelect",
                  action: "change->post-locations#companyChanged" } } %>
  </div>

  <div class="form-group">
    <%= form.label :category_id %>
    <%= form.collection_select :category_id, Category.order(:name), :id, :name,
        { prompt: t('.category_prompt') }, {} %>
  </div>

  <div class="form-group">
    <%= form.label :location_ids %>
    <div data-post-locations-target="locationsContainer"
         class="checkbox-group"
         data-no-company="<%= t('.locations_hint') %>"
         data-no-locations="<%= t('.no_locations') %>">
      <% if post.company_id.present? %>
        <% Location.where(company_id: post.company_id).order(:name).each do |l| %>
          <label>
            <input type="checkbox" name="post[location_ids][]" value="<%= l.id %>"
              <%= post.location_ids.include?(l.id) ? "checked" : "" %>>
            <%= l.name %>
          </label>
        <% end %>
      <% else %>
        <em class="text-muted text-sm"><%= t('.locations_hint') %></em>
      <% end %>
    </div>
    <button type="button"
      data-post-locations-target="selectAllBtn"
      data-action="click->post-locations#toggleAll"
      data-select-text="<%= t('.select_all') %>"
      data-deselect-text="<%= t('.deselect_all') %>"
      <%= post.company_id.blank? ? 'hidden' : '' %>>
      <%= t('.select_all') %>
    </button>
  </div>

  <div class="form-group">
    <%= form.label :tag_ids %>
    <div class="checkbox-group">
      <% selected_tag_ids = post.tag_ids %>
      <% Tag.order(:name).each do |tag| %>
        <label>
          <input type="checkbox" name="post[tag_ids][]" value="<%= tag.id %>"
            <%= selected_tag_ids.include?(tag.id) ? "checked" : "" %>>
          <%= tag.name %>
        </label>
      <% end %>
    </div>
  </div>

  <div class="form-group">
    <%= form.label :starts_at %>
    <%= form.datetime_local_field :starts_at %>
  </div>

  <div class="form-group">
    <%= form.label :ends_at %>
    <%= form.datetime_local_field :ends_at %>
  </div>

  <div class="form-actions">
    <%= form.submit %>
    <%= link_to t('.cancel'), admin_posts_path, class: "btn btn-secondary" %>
  </div>

<% end %>
