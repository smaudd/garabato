<% content_for :page_title, @post.title %>
<% content_for :header_actions do %>
  <%= link_to "Editar", edit_admin_post_path(@post), class: "btn btn-secondary" %>
  <%= button_to "Eliminar", admin_post_path(@post), method: :delete,
      data: { turbo_confirm: "¿Eliminar esta promoción?" },
      class: "btn btn-danger" %>
<% end %>

<%= link_to "Volver a promociones", admin_posts_path, class: "back-link" %>

<div class="card">
  <div class="card-body">
    <div class="detail-grid">
      <div class="detail-field">
        <div class="field-label">Empresa</div>
        <div class="field-value"><%= @post.company&.name || "—" %></div>
      </div>
      <div class="detail-field">
        <div class="field-label">Categoría</div>
        <div class="field-value"><%= @post.category&.name || "—" %></div>
      </div>
      <div class="detail-field full">
        <div class="field-label">Descripción</div>
        <div class="field-value"><%= @post.body.presence || "—" %></div>
      </div>
      <div class="detail-field">
        <div class="field-label">Inicio</div>
        <div class="field-value"><%= @post.starts_at&.strftime("%d/%m/%Y %H:%M") || "—" %></div>
      </div>
      <div class="detail-field">
        <div class="field-label">Fin</div>
        <div class="field-value"><%= @post.ends_at&.strftime("%d/%m/%Y %H:%M") || "—" %></div>
      </div>
      <div class="detail-field full">
        <div class="field-label">Locales</div>
        <div class="field-value">
          <% if @post.locations.any? %>
            <div class="flex flex-wrap gap-2">
              <% @post.locations.each do |l| %>
                <span class="badge badge-gray"><%= l.name %></span>
              <% end %>
            </div>
          <% else %>—<% end %>
        </div>
      </div>
      <div class="detail-field full">
        <div class="field-label">Tags</div>
        <div class="field-value">
          <% if @post.tags.any? %>
            <div class="flex flex-wrap gap-2">
              <% @post.tags.each do |t| %>
                <span class="badge badge-green"><%= t.name %></span>
              <% end %>
            </div>
          <% else %>—<% end %>
        </div>
      </div>
    </div>
  </div>
</div>
