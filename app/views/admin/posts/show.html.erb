<% content_for :page_title, @post.title %>
<% content_for :header_actions do %>
  <%= link_to t('admin.shared.edit'), edit_admin_post_path(@post), class: "btn btn-secondary" %>
  <%= button_to t('admin.shared.delete'), admin_post_path(@post), method: :delete,
      data: { turbo_confirm: t('.confirm_delete') },
      class: "btn btn-danger" %>
<% end %>

<%= link_to t('.back'), admin_posts_path, class: "back-link" %>

<div class="card">
  <div class="card-body">
    <div class="detail-grid">
      <div class="detail-field">
        <div class="field-label"><%= t('.field_company') %></div>
        <div class="field-value"><%= @post.company&.name || "—" %></div>
      </div>
      <div class="detail-field">
        <div class="field-label"><%= t('.field_category') %></div>
        <div class="field-value"><%= @post.category&.name || "—" %></div>
      </div>
      <div class="detail-field full">
        <div class="field-label"><%= t('.field_body') %></div>
        <div class="field-value"><%= @post.body.presence || "—" %></div>
      </div>
      <div class="detail-field">
        <div class="field-label"><%= t('.field_starts_at') %></div>
        <div class="field-value"><%= @post.starts_at&.strftime("%d/%m/%Y %H:%M") || "—" %></div>
      </div>
      <div class="detail-field">
        <div class="field-label"><%= t('.field_ends_at') %></div>
        <div class="field-value"><%= @post.ends_at&.strftime("%d/%m/%Y %H:%M") || "—" %></div>
      </div>
      <div class="detail-field full">
        <div class="field-label"><%= t('.field_locations') %></div>
        <div class="field-value">
          <% if @post.locations.any? %>
            <div class="flex flex-wrap gap-2">
              <% @post.locations.each do |loc| %>
                <span class="badge badge-gray"><%= loc.name %></span>
              <% end %>
            </div>
          <% else %>—<% end %>
        </div>
      </div>
      <div class="detail-field full">
        <div class="field-label"><%= t('.field_tags') %></div>
        <div class="field-value">
          <% if @post.tags.any? %>
            <div class="flex flex-wrap gap-2">
              <% @post.tags.each do |tag| %>
                <span class="badge badge-green"><%= tag.name %></span>
              <% end %>
            </div>
          <% else %>—<% end %>
        </div>
      </div>
    </div>
  </div>
</div>
