<h1><%= @post.title %></h1>

<p><strong>Company:</strong> <%= @post.company&.name %></p>
<p><strong>Category:</strong> <%= @post.category&.name %></p>
<p><strong>Body:</strong> <%= @post.body %></p>
<p><strong>Starts at:</strong> <%= @post.starts_at&.strftime("%d/%m/%Y") %></p>
<p><strong>Ends at:</strong> <%= @post.ends_at&.strftime("%d/%m/%Y") %></p>
<p><strong>Locations:</strong> <%= @post.locations.map(&:name).join(", ").presence || "—" %></p>
<p><strong>Tags:</strong> <%= @post.tags.map(&:name).join(", ").presence || "—" %></p>

<div>
  <%= link_to "Edit", edit_admin_post_path(@post) %> |
  <%= button_to "Delete", admin_post_path(@post), method: :delete, data: { turbo_confirm: "Are you sure?" } %> |
  <%= link_to "Back to posts", admin_posts_path %>
</div>
