<% content_for :page_title, @chat_video.title %>
<% content_for :header_actions do %>
  <%= link_to t("admin.shared.edit"), edit_admin_chat_video_path(@chat_video), class: "btn btn-primary" %>
<% end %>

<div class="card">
  <dl class="detail-list">
    <div>
      <dt><%= t(".field_slug") %></dt>
      <dd class="font-mono"><%= @chat_video.slug %></dd>
    </div>
    <div>
      <dt><%= t(".field_accent_color") %></dt>
      <dd>
        <span class="color-swatch" style="background:<%= @chat_video.accent_color %>"></span>
        <%= @chat_video.accent_color %>
      </dd>
    </div>
    <div>
      <dt><%= t(".field_tts_model") %></dt>
      <dd class="font-mono"><%= @chat_video.tts_model %></dd>
    </div>
    <div>
      <dt><%= t(".field_voice") %></dt>
      <dd class="font-mono"><%= @chat_video.voice %></dd>
    </div>
    <div>
      <dt><%= t(".field_question_voice") %></dt>
      <dd class="font-mono"><%= @chat_video.question_voice %></dd>
    </div>
    <div>
      <dt><%= t(".field_question_display_ms") %></dt>
      <dd><%= @chat_video.question_display_ms %> ms</dd>
    </div>
    <% if @chat_video.background.attached? %>
      <div>
        <dt><%= t(".field_background") %></dt>
        <dd>
          <% if @chat_video.background.content_type.start_with?("video/") %>
            <video src="<%= url_for(@chat_video.background) %>" controls class="media-preview"></video>
          <% else %>
            <img src="<%= url_for(@chat_video.background) %>" alt="Background" class="media-preview">
          <% end %>
          <p class="file-current"><%= link_to @chat_video.background.filename, url_for(@chat_video.background) %></p>
        </dd>
      </div>
    <% end %>
    <% if @chat_video.rendered_video.attached? %>
      <div>
        <dt><%= t(".field_rendered_video") %></dt>
        <dd>
          <video src="<%= url_for(@chat_video.rendered_video) %>" controls class="media-preview"></video>
          <p class="file-current"><%= link_to @chat_video.rendered_video.filename, url_for(@chat_video.rendered_video) %></p>
        </dd>
      </div>
    <% end %>
  </dl>
</div>

<% if @chat_video.chat_entries.any? %>
  <h2 class="section-title"><%= t(".entries_section") %></h2>
  <% @chat_video.chat_entries.each_with_index do |entry, i| %>
    <div class="card entry-card">
      <h3 class="entry-header">
        <span class="emoji"><%= entry.avatar_emoji %></span>
        <%= entry.username %>
        <% if entry.bubble_color.present? %>
          <span class="color-swatch" style="background:<%= entry.bubble_color %>"></span>
        <% end %>
      </h3>
      <dl class="detail-list">
        <% if entry.question_voice.present? %>
          <div>
            <dt><%= ChatEntry.human_attribute_name(:question_voice) %></dt>
            <dd class="font-mono"><%= entry.question_voice %></dd>
          </div>
        <% end %>
        <div>
          <dt><%= ChatEntry.human_attribute_name(:question) %></dt>
          <dd><%= entry.question %></dd>
        </div>
        <div>
          <dt><%= ChatEntry.human_attribute_name(:answer) %></dt>
          <dd><%= entry.answer %></dd>
        </div>
        <% if entry.background.attached? %>
          <div>
            <dt><%= ChatEntry.human_attribute_name(:background) %></dt>
            <dd>
              <% if entry.background.content_type.start_with?("video/") %>
                <video src="<%= url_for(entry.background) %>" controls class="media-preview"></video>
              <% else %>
                <img src="<%= url_for(entry.background) %>" alt="Background" class="media-preview">
              <% end %>
              <p class="file-current"><%= link_to entry.background.filename, url_for(entry.background) %></p>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
  <% end %>
<% end %>
