<%= form_with model: [:admin, chat_video], data: { controller: "nested-form" } do |f| %>
  <%= render "shared/error_messages", object: chat_video %>

  <fieldset class="fieldset">
    <legend class="fieldset-legend">Video</legend>

    <div class="field">
      <%= f.label :slug %>
      <%= f.text_field :slug, class: "input font-mono" %>
    </div>

    <div class="field">
      <%= f.label :title %>
      <%= f.text_field :title, class: "input" %>
    </div>

    <div class="field">
      <%= f.label :accent_color %>
      <div class="input-with-preview">
        <%= f.color_field :accent_color, class: "color-input" %>
        <%= f.text_field :accent_color, class: "input input-sm font-mono" %>
      </div>
    </div>

    <div class="field">
      <%= f.label :tts_model %>
      <%= f.text_field :tts_model, class: "input font-mono" %>
    </div>

    <div class="field">
      <%= f.label :voice %>
      <%= f.text_field :voice, class: "input font-mono" %>
    </div>

    <div class="field">
      <%= f.label :question_voice %>
      <%= f.text_field :question_voice, class: "input font-mono" %>
    </div>

    <div class="field">
      <%= f.label :question_display_ms %>
      <%= f.number_field :question_display_ms, class: "input input-sm", min: 0, step: 100 %>
    </div>

    <div class="field">
      <%= f.label :background %>
      <% if chat_video.background.attached? %>
        <div class="media-preview-wrap">
          <% if chat_video.background.content_type.start_with?("video/") %>
            <video src="<%= url_for(chat_video.background) %>" controls class="media-preview"></video>
          <% else %>
            <img src="<%= url_for(chat_video.background) %>" alt="Background" class="media-preview">
          <% end %>
          <p class="file-current"><%= chat_video.background.filename %></p>
        </div>
      <% end %>
      <%= f.file_field :background, class: "file-input", accept: "image/*,video/*" %>
    </div>

    <div class="field">
      <%= f.label :rendered_video %>
      <% if chat_video.rendered_video.attached? %>
        <div class="media-preview-wrap">
          <video src="<%= url_for(chat_video.rendered_video) %>" controls class="media-preview"></video>
          <p class="file-current"><%= chat_video.rendered_video.filename %></p>
        </div>
      <% end %>
      <%= f.file_field :rendered_video, class: "file-input", accept: "video/*" %>
    </div>
  </fieldset>

  <fieldset class="fieldset" data-nested-form-target="container">
    <legend class="fieldset-legend"><%= t("admin.chat_videos.form.entries_section") %></legend>

    <template data-nested-form-target="template">
      <%= f.fields_for :chat_entries, ChatEntry.new, child_index: "NEW_RECORD" do |ef| %>
        <%= render "entry_fields", f: ef, n: "?" %>
      <% end %>
    </template>

    <%= f.fields_for :chat_entries do |ef| %>
      <%= render "entry_fields", f: ef, n: ef.index.to_i + 1 %>
    <% end %>
  </fieldset>

  <div class="form-actions">
    <%= button_tag t("admin.chat_videos.form.add_entry"),
        type: "button", class: "btn btn-outline",
        data: { action: "nested-form#addEntry" } %>
  </div>

  <div class="form-actions form-actions--submit">
    <%= link_to t("admin.chat_videos.form.cancel"), :back, class: "btn btn-secondary" %>
    <%= f.submit class: "btn btn-primary" %>
  </div>
<% end %>
