<% content_for :page_title, t(".page_title") %>
<% content_for :header_actions do %>
  <%= link_to t(".new"), new_admin_chat_video_path, class: "btn btn-primary" %>
<% end %>

<div class="card">
  <% if @chat_videos.any? %>
    <div class="table-responsive">
      <table class="data-table">
      <thead>
        <tr>
          <th><%= t(".col_slug") %></th>
          <th><%= t(".col_title") %></th>
          <th><%= t(".col_entries") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @chat_videos.each do |video| %>
          <tr>
            <td><%= link_to video.slug, admin_chat_video_path(video), class: "font-mono text-sm" %></td>
            <td><%= video.title %></td>
            <td class="text-muted"><%= video.chat_entries.count %></td>
            <td>
              <div class="td-actions">
                <%= link_to t("admin.shared.edit"), edit_admin_chat_video_path(video) %>
                <%= button_to t("admin.shared.delete"), admin_chat_video_path(video), method: :delete,
                    data: { turbo_confirm: t(".confirm_delete") } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  <% else %>
    <div class="table-empty">
      <%= t(".empty") %> <%= link_to t(".empty_link"), new_admin_chat_video_path %>.
    </div>
  <% end %>
</div>
