<h1>Panel de administración</h1>

<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 2rem;">
  <div>
    <h2>Empresas (<%= @companies_count %>)</h2>
    <%= link_to "Ver empresas", admin_companies_path %> |
    <%= link_to "Nueva empresa", new_admin_company_path %>
  </div>

  <div>
    <h2>Locales (<%= @locations_count %>)</h2>
    <%= link_to "Ver por empresa", admin_companies_path %>
  </div>

  <div>
    <h2>Promociones (<%= @posts_count %>)</h2>
    <%= link_to "Ver promociones", admin_posts_path %> |
    <%= link_to "Nueva promoción", new_admin_post_path %>
  </div>

  <div>
    <h2>Categorías (<%= @categories_count %>)</h2>
    <%= link_to "Ver categorías", admin_categories_path %> |
    <%= link_to "Nueva categoría", new_admin_category_path %>
  </div>

  <div>
    <h2>Tags (<%= @tags_count %>)</h2>
    <%= link_to "Ver tags", admin_tags_path %> |
    <%= link_to "Nuevo tag", new_admin_tag_path %>
  </div>
</div>

<h2>Últimas promociones</h2>

<% if @recent_posts.any? %>
  <table>
    <thead>
      <tr>
        <th>Título</th>
        <th>Empresa</th>
        <th>Categoría</th>
        <th>Creada</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @recent_posts.each do |post| %>
        <tr>
          <td><%= post.title %></td>
          <td><%= post.company&.name || "—" %></td>
          <td><%= post.category&.name || "—" %></td>
          <td><%= post.created_at.strftime("%d/%m/%Y") %></td>
          <td>
            <%= link_to "Ver", admin_post_path(post) %> |
            <%= link_to "Editar", edit_admin_post_path(post) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= link_to "Ver todas las promociones →", admin_posts_path %>
<% else %>
  <p>No hay promociones todavía. <%= link_to "Crea la primera", new_admin_post_path %>.</p>
<% end %>
