<% content_for :page_title, t('.page_title') %>
<% content_for :header_actions do %>
  <%= link_to t('.new_post'), new_admin_post_path, class: "btn btn-primary" %>
<% end %>

<div class="stats-grid">
  <%= link_to admin_companies_path, class: "stat-card" do %>
    <div class="stat-value"><%= @companies_count %></div>
    <div class="stat-label"><%= t('.companies_label') %></div>
    <div class="stat-link"><%= t('.companies_link') %></div>
  <% end %>

  <%= link_to admin_companies_path, class: "stat-card" do %>
    <div class="stat-value"><%= @locations_count %></div>
    <div class="stat-label"><%= t('.locations_label') %></div>
    <div class="stat-link"><%= t('.locations_link') %></div>
  <% end %>

  <%= link_to admin_posts_path, class: "stat-card" do %>
    <div class="stat-value"><%= @posts_count %></div>
    <div class="stat-label"><%= t('.posts_label') %></div>
    <div class="stat-link"><%= t('.posts_link') %></div>
  <% end %>

  <%= link_to admin_categories_path, class: "stat-card" do %>
    <div class="stat-value"><%= @categories_count %></div>
    <div class="stat-label"><%= t('.categories_label') %></div>
    <div class="stat-link"><%= t('.categories_link') %></div>
  <% end %>

  <%= link_to admin_tags_path, class: "stat-card" do %>
    <div class="stat-value"><%= @tags_count %></div>
    <div class="stat-label"><%= t('.tags_label') %></div>
    <div class="stat-link"><%= t('.tags_link') %></div>
  <% end %>
</div>

<div class="card">
  <div class="card-header">
    <h2><%= t('.recent_title') %></h2>
    <%= link_to t('.view_all'), admin_posts_path, class: "btn btn-secondary btn-sm" %>
  </div>

  <% if @recent_posts.any? %>
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t('.col_title') %></th>
          <th><%= t('.col_company') %></th>
          <th><%= t('.col_category') %></th>
          <th><%= t('.col_created') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @recent_posts.each do |post| %>
          <tr>
            <td><%= post.title %></td>
            <td><%= post.company&.name || "—" %></td>
            <td><%= post.category&.name.present? ? post.category.name : "—" %></td>
            <td class="text-muted text-sm"><%= post.created_at.strftime("%d/%m/%Y") %></td>
            <td>
              <div class="td-actions">
                <%= link_to t('.see'), admin_post_path(post) %>
                <%= link_to t('admin.shared.edit'), edit_admin_post_path(post) %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="table-empty"><%= t('.empty') %> <%= link_to t('.empty_link'), new_admin_post_path %></div>
  <% end %>
</div>

