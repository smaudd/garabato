<% content_for :page_title, "Dashboard" %>
<% content_for :header_actions do %>
  <%= link_to "Nueva promoción", new_admin_post_path, class: "btn btn-primary" %>
<% end %>

<div class="stats-grid">
  <%= link_to admin_companies_path, class: "stat-card" do %>
    <div class="stat-value"><%= @companies_count %></div>
    <div class="stat-label">Empresas</div>
    <div class="stat-link">Ver todas →</div>
  <% end %>

  <%= link_to admin_companies_path, class: "stat-card" do %>
    <div class="stat-value"><%= @locations_count %></div>
    <div class="stat-label">Locales</div>
    <div class="stat-link">Ver por empresa →</div>
  <% end %>

  <%= link_to admin_posts_path, class: "stat-card" do %>
    <div class="stat-value"><%= @posts_count %></div>
    <div class="stat-label">Promociones</div>
    <div class="stat-link">Ver todas →</div>
  <% end %>

  <%= link_to admin_categories_path, class: "stat-card" do %>
    <div class="stat-value"><%= @categories_count %></div>
    <div class="stat-label">Categorías</div>
    <div class="stat-link">Ver todas →</div>
  <% end %>

  <%= link_to admin_tags_path, class: "stat-card" do %>
    <div class="stat-value"><%= @tags_count %></div>
    <div class="stat-label">Tags</div>
    <div class="stat-link">Ver todos →</div>
  <% end %>
</div>

<div class="card">
  <div class="card-header">
    <h2>Últimas promociones</h2>
    <%= link_to "Ver todas", admin_posts_path, class: "btn btn-secondary btn-sm" %>
  </div>

  <% if @recent_posts.any? %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Título</th>
          <th>Empresa</th>
          <th>Categoría</th>
          <th>Creada</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @recent_posts.each do |post| %>
          <tr>
            <td><%= post.title %></td>
            <td><%= post.company&.name || "—" %></td>
            <td><%= post.category&.name.present? ? post.category.name : "—" %></td>
            <td class="text-muted text-sm"><%= post.created_at.strftime("%d/%m/%Y") %></td>
            <td>
              <div class="td-actions">
                <%= link_to "Ver", admin_post_path(post) %>
                <%= link_to "Editar", edit_admin_post_path(post) %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="table-empty">Aún no hay promociones. <%= link_to "Crear la primera", new_admin_post_path %></div>
  <% end %>
</div>

