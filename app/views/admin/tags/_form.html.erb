<%= form_with model: [:admin, tag] do |form| %>
  <% if tag.errors.any? %>
    <div class="form-errors">
      <strong><%= pluralize(tag.errors.count, "error") %> impidieron guardar:</strong>
      <ul>
        <% tag.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name, "Nombre" %>
    <%= form.text_field :name, placeholder: "Nombre del tag" %>
  </div>

  <div class="form-actions">
    <%= form.submit %>
    <%= link_to "Cancelar", admin_tags_path, class: "btn btn-secondary" %>
  </div>
<% end %>
