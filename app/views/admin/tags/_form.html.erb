<%= form_with model: [:admin, tag] do |form| %>
  <% if tag.errors.any? %>
    <div class="form-errors">
      <strong><%= t('admin.shared.errors', count: tag.errors.count) %></strong>
      <ul>
        <% tag.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name %>
    <%= form.text_field :name, placeholder: t('.placeholder_name') %>
  </div>

  <div class="form-actions">
    <%= form.submit %>
    <%= link_to t('.cancel'), admin_tags_path, class: "btn btn-secondary" %>
  </div>
<% end %>
