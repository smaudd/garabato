<% content_for :page_title, t('.page_title') %>
<% content_for :header_actions do %>
  <%= link_to t('.new'), new_admin_tag_path, class: "btn btn-primary" %>
<% end %>

<div class="card">
  <% if @tags.any? %>
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t('.col_name') %></th>
          <th><%= t('.col_posts') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @tags.each do |tag| %>
          <tr>
            <td><%= link_to tag.name, admin_tag_path(tag) %></td>
            <td class="text-muted"><%= tag.posts.count %></td>
            <td>
              <div class="td-actions">
                <%= link_to t('admin.shared.edit'), edit_admin_tag_path(tag) %>
                <%= button_to t('admin.shared.delete'), admin_tag_path(tag), method: :delete, data: { turbo_confirm: t('.confirm_delete') } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="table-empty"><%= t('.empty') %> <%= link_to t('.empty_link'), new_admin_tag_path %>.</div>
  <% end %>
</div>
