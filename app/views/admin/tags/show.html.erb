<% content_for :page_title, @tag.name %>
<% content_for :header_actions do %>
  <%= link_to "Editar", edit_admin_tag_path(@tag), class: "btn btn-secondary" %>
<% end %>

<%= link_to "Volver a tags", admin_tags_path, class: "back-link" %>

<div class="card">
  <div class="card-body">
    <div class="detail-field">
      <div class="field-label">Promociones asociadas</div>
      <div class="field-value"><%= @tag.posts.count %></div>
    </div>
  </div>
</div>
