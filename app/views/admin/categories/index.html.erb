<h1>Categories</h1>

<%= link_to "New category", new_admin_category_path %>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Posts</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr>
        <td><%= category.name %></td>
        <td><%= category.posts.count %></td>
        <td>
          <%= link_to "Edit", edit_admin_category_path(category) %> |
          <%= button_to "Delete", admin_category_path(category), method: :delete, data: { turbo_confirm: "Are you sure?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
