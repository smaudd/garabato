<% content_for :page_title, t('.page_title') %>
<% content_for :header_actions do %>
  <%= link_to t('.new'), new_admin_category_path, class: "btn btn-primary" %>
<% end %>

<div class="card">
  <% if @categories.any? %>
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t('.col_name') %></th>
          <th><%= t('.col_posts') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @categories.each do |category| %>
          <tr>
            <td><%= link_to category.name, admin_category_path(category) %></td>
            <td class="text-muted"><%= category.posts.count %></td>
            <td>
              <div class="td-actions">
                <%= link_to t('admin.shared.edit'), edit_admin_category_path(category) %>
                <%= button_to t('admin.shared.delete'), admin_category_path(category), method: :delete, data: { turbo_confirm: t('.confirm_delete') } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="table-empty"><%= t('.empty') %> <%= link_to t('.empty_link'), new_admin_category_path %>.</div>
  <% end %>
</div>
