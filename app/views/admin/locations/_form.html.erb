<%= form_with model: [:admin, company, location] do |form| %>
  <% if location.errors.any? %>
    <div class="form-errors">
      <strong><%= pluralize(location.errors.count, "error") %> impidieron guardar:</strong>
      <ul>
        <% location.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name, "Nombre" %>
    <%= form.text_field :name, placeholder: "Nombre del local" %>
  </div>

  <div class="form-group">
    <%= form.label :address, "Dirección" %>
    <%= form.text_field :address, placeholder: "Dirección completa" %>
  </div>

  <div class="form-group">
    <%= form.label :phone, "Teléfono" %>
    <%= form.telephone_field :phone, placeholder: "+34 600 000 000" %>
  </div>

  <div class="form-actions">
    <%= form.submit %>
    <%= link_to "Cancelar", admin_company_path(company), class: "btn btn-secondary" %>
  </div>
<% end %>
