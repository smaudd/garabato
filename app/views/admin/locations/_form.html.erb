<%= form_with model: [:admin, company, location] do |form| %>
  <% if location.errors.any? %>
    <div class="form-errors">
      <strong><%= t('admin.shared.errors', count: location.errors.count) %></strong>
      <ul>
        <% location.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name %>
    <%= form.text_field :name, placeholder: t('.placeholder_name') %>
  </div>

  <div class="form-group">
    <%= form.label :address %>
    <%= form.text_field :address, placeholder: t('.placeholder_address') %>
  </div>

  <div class="form-group">
    <%= form.label :phone %>
    <%= form.telephone_field :phone, placeholder: t('.placeholder_phone') %>
  </div>

  <div class="form-actions">
    <%= form.submit %>
    <%= link_to t('.cancel'), admin_company_path(company), class: "btn btn-secondary" %>
  </div>
<% end %>
