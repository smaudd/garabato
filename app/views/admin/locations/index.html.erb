<h1>Locations — <%= @company.name %></h1>

<%= link_to "New location", new_admin_company_location_path(@company) %>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Address</th>
      <th>Phone</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @locations.each do |location| %>
      <tr>
        <td><%= location.name %></td>
        <td><%= location.address %></td>
        <td><%= location.phone %></td>
        <td>
          <%= link_to "Edit", edit_admin_company_location_path(@company, location) %> |
          <%= button_to "Delete", admin_company_location_path(@company, location), method: :delete, data: { turbo_confirm: "Are you sure?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "Back to company", admin_company_path(@company) %>
