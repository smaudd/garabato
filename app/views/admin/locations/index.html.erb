<% content_for :page_title, t('.page_title', company: @company.name) %>
<% content_for :header_actions do %>
  <%= link_to t('.new'), new_admin_company_location_path(@company), class: "btn btn-primary" %>
<% end %>

<%= link_to t('.back', company: @company.name), admin_company_path(@company), class: "back-link" %>

<div class="card">
  <% if @locations.any? %>
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t('.col_name') %></th>
          <th><%= t('.col_address') %></th>
          <th><%= t('.col_phone') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @locations.each do |location| %>
          <tr>
            <td><%= location.name %></td>
            <td class="text-muted"><%= location.address %></td>
            <td class="text-muted"><%= location.phone.presence || "—" %></td>
            <td>
              <div class="td-actions">
                <%= link_to t('admin.shared.edit'), edit_admin_company_location_path(@company, location) %>
                <%= button_to t('admin.shared.delete'), admin_company_location_path(@company, location), method: :delete, data: { turbo_confirm: t('.confirm_delete') } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="table-empty"><%= t('.empty') %></div>
  <% end %>
</div>
