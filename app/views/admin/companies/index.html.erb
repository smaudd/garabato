<% content_for :page_title, t('.page_title') %>
<% content_for :header_actions do %>
  <%= link_to t('.new'), new_admin_company_path, class: "btn btn-primary" %>
<% end %>

<div class="card">
  <% if @companies.any? %>
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t('.col_name') %></th>
          <th><%= t('.col_website') %></th>
          <th><%= t('.col_locations') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @companies.each do |company| %>
          <tr>
            <td><%= link_to company.name, admin_company_path(company) %></td>
            <td class="text-muted text-sm"><%= company.website.presence || "—" %></td>
            <td class="text-muted"><%= company.locations.count %></td>
            <td>
              <div class="td-actions">
                <%= link_to t('admin.shared.edit'), edit_admin_company_path(company) %>
                <%= button_to t('admin.shared.delete'), admin_company_path(company), method: :delete, data: { turbo_confirm: t('.confirm_delete') } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="table-empty"><%= t('.empty') %> <%= link_to t('.empty_link'), new_admin_company_path %>.</div>
  <% end %>
</div>
