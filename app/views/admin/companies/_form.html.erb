<%= form_with model: [:admin, company] do |form| %>
  <% if company.errors.any? %>
    <div class="form-errors">
      <strong><%= pluralize(company.errors.count, "error") %> impidieron guardar:</strong>
      <ul>
        <% company.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name, "Nombre" %>
    <%= form.text_field :name, placeholder: "Nombre de la empresa" %>
  </div>

  <div class="form-group">
    <%= form.label :description, "Descripción" %>
    <%= form.text_area :description, placeholder: "Descripción breve (opcional)" %>
  </div>

  <div class="form-group">
    <%= form.label :website, "Website" %>
    <%= form.url_field :website, placeholder: "https://..." %>
  </div>

  <div class="form-actions">
    <%= form.submit %>
    <%= link_to "Cancelar", admin_companies_path, class: "btn btn-secondary" %>
  </div>
<% end %>
