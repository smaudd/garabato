<%= form_with model: [:admin, company] do |form| %>
  <% if company.errors.any? %>
    <div class="form-errors">
      <strong><%= t('admin.shared.errors', count: company.errors.count) %></strong>
      <ul>
        <% company.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name %>
    <%= form.text_field :name, placeholder: t('.placeholder_name') %>
  </div>

  <div class="form-group">
    <%= form.label :description %>
    <%= form.text_area :description, placeholder: t('.placeholder_description') %>
  </div>

  <div class="form-group">
    <%= form.label :website %>
    <%= form.url_field :website, placeholder: t('.placeholder_website') %>
  </div>

  <div class="form-actions">
    <%= form.submit %>
    <%= link_to t('.cancel'), admin_companies_path, class: "btn btn-secondary" %>
  </div>
<% end %>
